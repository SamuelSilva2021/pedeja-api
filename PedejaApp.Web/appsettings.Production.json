{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=your-production-server;Database=PedejaAppProd;Trusted_Connection=true;MultipleActiveResultSets=true;TrustServerCertificate=true"
  },
  "FileStorage": {
    "BaseUrl": "https://api.seudominio.com/uploads",
    "EnableCdn": true,
    "CdnUrl": "https://cdn.seudominio.com/uploads",
    "UploadPath": "wwwroot/uploads",
    "MaxFileSize": 5242880,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".webp"]
  },
  "Authentication": {
    "JwtSettings": {
      "SecretKey": "your-super-secure-jwt-secret-key-for-production-minimum-32-characters",
      "Issuer": "https://api.seudominio.com",
      "Audience": "https://app.seudominio.com",
      "ExpirationInMinutes": 60
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.seudominio.com",
      "https://www.seudominio.com"
    ]
  },
  "HealthChecks": {
    "Enabled": true,
    "DetailedErrors": false
  },
  "Cache": {
    "Redis": {
      "ConnectionString": "your-redis-connection-string",
      "InstanceName": "PedejaApp"
    }
  },
  "Monitoring": {
    "ApplicationInsights": {
      "InstrumentationKey": "your-application-insights-key"
    }
  }
}